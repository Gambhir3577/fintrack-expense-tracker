# FinTrack Backend Environment Configuration
PORT=5001
NODE_ENV=development

# Database Connection (PostgreSQL - Neon, Supabase, or Local)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/fintrack?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fintrack?schema=public"

# Authentication Secrets (generate random 32+ character strings)
JWT_ACCESS_SECRET="fintrack_jwt_access_secret_key_super_secure_32_chars_min"
JWT_REFRESH_SECRET="fintrack_jwt_refresh_secret_key_super_secure_32_chars_min"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# Google Gemini API Key for Server-Side AI Proxy
GEMINI_API_KEY=""

# Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS="https://fintrack-expense-tracker-xi.vercel.app,http://localhost:5173,https://localhost,capacitor://localhost"
